{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },

      "catalog": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        }
      },

      "basket": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/basket/{**catch-all}"
        }
      },

      "ordering": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:2000/"
          }
        }
      },

      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://localhost:6000/"
          }
        }
      },

      "basket-cluster": {
        "Destinations": {
          "basket-api": {
            "Address": "http://localhost:7000/"
          }
        }
      },

      "ordering-cluster": {
        "Destinations": {
          "ordering-api": {
            "Address": "http://localhost:5000/"
          }
        }
      }
    }
  },

  "SwaggerServices": [
    {
      "Name": "Identity API",
      "SwaggerEndpoint": "http://localhost:1000/identity/swagger/v1/swagger.json"
    },
    {
      "Name": "Catalog API",
      "SwaggerEndpoint": "http://localhost:1000/catalog/swagger/v1/swagger.json"
    },
    {
      "Name": "Basket API",
      "SwaggerEndpoint": "http://localhost:1000/basket/swagger/v1/swagger.json"
    },
    {
      "Name": "Ordering API",
      "SwaggerEndpoint": "http://localhost:1000/ordering/swagger/v1/swagger.json"
    }
  ]
}